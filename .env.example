# GitHub Personal Access Token (for remote repo sync & PR automation)
GITHUB_TOKEN="your-github-token-here"

# Email Notification Service (Resend API recommended, or SendGrid)
# Get a free API key at https://resend.com
RESEND_API_KEY="re_your_api_key_here"
SENDER_EMAIL="onboarding@resend.dev"
NOTIFICATION_EMAIL="neftalibautista1415@gmail.com"

# Optional LLM APIs (for Resume Tailoring & Deep Semantic Matchers)
OPENROUTER_API_KEY="your-openrouter-key-here"
GEMINI_API_KEY="your-gemini-key-here"

# Pipeline Runtime Controls
TARGET_METRO="DFW"
MAX_APPLICANTS_THRESHOLD=100
MAX_POSTING_AGE_DAYS=7
LINK_VALIDATOR_WORKERS=5
LINK_VALIDATOR_TIMEOUT_SECONDS=5
